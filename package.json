{
  "name": "taff01",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "dev": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/dev.ts",
    "build": "node --env-file=.env node_modules/turbo/bin/turbo build",
    "lint": "biome check .",
    "typecheck": "turbo typecheck",
    "test": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run",
    "db:generate": "pnpm --filter @taff/db generate",
    "db:migrate": "node --env-file=.env node_modules/tsx/dist/cli.mjs packages/core/src/migrate.ts",
    "db:seed": "node --env-file=.env node_modules/tsx/dist/cli.mjs packages/core/src/seed.ts",
    "e2e": "node --env-file=.env node_modules/@playwright/test/cli.js test",
    "perf:budget": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/bundle-budget.mts",
    "mcp:smoke": "node --env-file=.env node_modules/tsx/dist/cli.mjs apps/api/scripts/mcp-smoke.mts",
    "release:checklist": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test --config playwright.release.config.ts",
    "release:stack": "node --env-file-if-exists=.env scripts/release-stack.mjs",
    "build:server": "node node_modules/tsx/dist/cli.mjs scripts/build-server.mts",
    "licence:check": "node node_modules/tsx/dist/cli.mjs scripts/licence-gate.mts",
    "perf:lcp": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/perf-lcp.mts",
    "perf:lighthouse": "node --env-file=.env node_modules/tsx/dist/cli.mjs scripts/perf-lighthouse.mts",
    "ui:prototype-shots": "node scripts/ui/prototype-shots.mjs",
    "ui:app-shots": "node --env-file=.env scripts/ui/app-shots.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@modelcontextprotocol/client": "^2.3.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "lighthouse": "13.5.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.8",
    "typescript": "~7.0.2",
    "vitest": "^5.0.5"
  }
}
