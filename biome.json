{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/.next",
      "!!**/migrations",
      "!!backend/**/tests/fixtures",
      "!!**/__fixtures__",
      "!!packages/schemas/generated",
      "!!docs/ui/prototype",
      "!!docs/ui/prototype-v2",
      "!!pnpm-lock.yaml",
      "!!**/next-env.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": [
        "scripts/**/*.ts",
        "scripts/**/*.mts",
        "e2e/**/*.ts",
        "e2e/**/*.mts",
        "playwright*.config.ts",
        "vitest.config.mts",
        "apps/web/scripts/**/*.mts"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "error",
            "noTsIgnore": "error"
          }
        }
      }
    }
  ]
}
