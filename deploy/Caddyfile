# SITE_ADDRESS is the public host (automatic HTTPS) or ":80" behind another proxy.
{$SITE_ADDRESS} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	@backend path /api/* /mcp /mcp/*
	handle /api/costs/* {
		reverse_proxy api-rs:3003
	}
	handle /api/project-updates {
		reverse_proxy api-rs:3003
	}
	@taskLinks path /api/task-links /api/task-links/*
	handle @taskLinks {
		reverse_proxy api-rs:3003
	}
	@taskCriteria path /api/task-criteria /api/task-criteria/*
	handle @taskCriteria {
		reverse_proxy api-rs:3003
	}
	@timeTracking path /api/time-entries /api/time-entries/* /api/member-rates
	handle @timeTracking {
		reverse_proxy api-rs:3003
	}
	@timelineReads {
		method GET
		path_regexp ^/api/projects/[^/]+/(timeline|milestones|payments)$
	}
	handle @timelineReads {
		reverse_proxy api-rs:3003
	}
	reverse_proxy @backend api:3001
	reverse_proxy web:3000
}
