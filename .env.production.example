# Production values for compose.prod.yaml. Copy to .env.production (git-ignored).
# Public origin users open; Caddy serves it and the API trusts it for cookies and CORS.
AUTH_URL=https://taff.apuch.cn
# Caddy site address: the public host for automatic HTTPS, or ":80" behind another TLS proxy.
SITE_ADDRESS=taff.apuch.cn
POSTGRES_PASSWORD=replace-with-a-long-random-password
# compose.apuch.yaml maps the certificate DNS name to ins-nx2vm7pc's private IP.
# URL-encode the database password. The bundled PostgreSQL service stays disabled.
DATABASE_URL=postgres://taff:replace-with-a-long-random-password@postgres01.internal.apuch.art:5432/taff?sslmode=verify-full
# Copy the public CA certificate from ins-nx2vm7pc; never copy its private key.
POSTGRES_CA_FILE=/srv/taff/secrets/postgresql-ca.crt
AUTH_SECRET=replace-with-at-least-32-random-characters
TOKEN_PEPPER=replace-with-random-token-pepper
MCP_RATE_LIMIT=60
# SMS login is disabled when these five values are empty. Fill all five from
# the approved SMS secret manager; never commit production values or OTPs.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
# Image names and tag used by compose; CI builds and tags them.
TAFF_IMAGE_API=taff-api
TAFF_IMAGE_WORKER=taff-worker
TAFF_IMAGE_WEB=taff-web
TAFF_TAG=latest

# Optional all-or-none SMTP configuration. No fields => private logging mailbox.
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
# Contains private invitation/verification links; never expose or commit this file.
EMAIL_LOG_PATH=.taff-mail/messages.jsonl

# Ask taff (M17): requests per person per minute; defaults to 20.
# ASK_RATE_LIMIT=20
# Optional model path for Ask taff (ADR 0016). PRODUCTION KEEPS THESE UNSET:
# workspace data must not reach a third-party model (D6). compose.prod.yaml
# does not pass them to the api service, so setting them here has no effect.
# AI_BASE_URL=
# AI_API_KEY=
# AI_MODEL=
