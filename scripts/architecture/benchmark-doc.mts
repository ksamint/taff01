// Writes the consolidated function map from scripts/architecture/benchmark.ts.
//   pnpm arch:benchmark           write docs/benchmark/function-map.md and the page
//   pnpm arch:benchmark --check   exit 1 when the committed table is stale
import { mkdirSync, readFileSync, writeFileSync } from "node:fs";
import path from "node:path";
import { CAPABILITIES, GROUPS, type Status } from "./benchmark.ts";
import { inventory, repoRoot } from "./inventory.ts";
import { omv } from "./omv-model.ts";

const { doc } = omv(inventory());
const objects = new Map(doc.m.objects.map((object) => [object.id, object]));
const types = new Map(doc.o.objectTypes.map((type) => [type.id, type.title]));
const word: Record<Status, string> = {
  yes: "Yes",
  partial: "Partly",
  no: "No",
};
const where = (ids: string[]) =>
  ids
    .map((id) => {
      const object = objects.get(id);
      return object
        ? `${object.title} (${(types.get(object.type) ?? object.type).toLowerCase()})`
        : id;
    })
    .join(", ");
const count = (group: string | null, status: Status) =>
  CAPABILITIES.filter(
    (item) => (group === null || item.group === group) && item.taff === status,
  ).length;
const total = (group: string | null) =>
  CAPABILITIES.filter((item) => group === null || item.group === group).length;

export function markdown(): string {
  const lines = [
    "# Function map: the field and Taff",
    "",
    "GENERATED by `pnpm arch:benchmark` from `scripts/architecture/benchmark.ts`. Do not edit.",
    "",
    `${total(null)} functions that project-management products offer, by group and category, and whether Taff has each today.`,
    "",
    "- **Seen in** names the products the reading material gives as a reference. It comes from vendor documentation and was not tested by hand.",
    "- **Taff** is Yes, Partly or No. **Where** names the objects of Taff's own model that show it; the unit tests fail if one does not exist.",
    "",
    "## Overview",
    "",
    "| Group | Functions | Yes | Partly | No |",
    "| --- | --- | --- | --- | --- |",
    ...GROUPS.map(
      (group) =>
        `| ${group} | ${total(group)} | ${count(group, "yes")} | ${count(group, "partial")} | ${count(group, "no")} |`,
    ),
    `| **All** | **${total(null)}** | **${count(null, "yes")}** | **${count(null, "partial")}** | **${count(null, "no")}** |`,
    "",
  ];
  for (const group of GROUPS) {
    lines.push(
      `## ${group}`,
      "",
      "| Category | Function | Seen in | Taff | Where in Taff | Note |",
      "| --- | --- | --- | --- | --- | --- |",
      ...CAPABILITIES.filter((item) => item.group === group).map(
        (item) =>
          `| ${item.category} | ${item.name} | ${item.seenIn} | ${word[item.taff]} | ${where(item.where)} | ${item.note} |`,
      ),
      "",
    );
  }
  return `${lines.join("\n")}`;
}

const esc = (value: string) =>
  value.replace(
    /[&<>"]/g,
    (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" })[c] ?? c,
  );
function page(): string {
  const bar = (group: string | null) => {
    const all = total(group) || 1;
    return `<span class="bar"><i class="yes" style="width:${(count(group, "yes") / all) * 100}%"></i><i class="partial" style="width:${(count(group, "partial") / all) * 100}%"></i></span>`;
  };
  return `<title>Taff Function Map</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap">
<style>
/* Layout: one overview table, then one table per group; status is a coloured word. */
:root { --bg:#fbf9fa; --surface:#fff; --mat:#eeebed; --ink:#0a1626; --body:#1b1b1d; --muted:#555a63; --line:rgba(10,22,38,.16); --hair:rgba(10,22,38,.08); --gold:#785f2a;
  --yes:#0f5132; --yes-bg:#d7eee0; --partial:#6b450a; --partial-bg:#f6ebd7; --no:#93000a; --no-bg:#ffdad6;
  --sans:"Manrope","PingFang HK","PingFang SC","Microsoft JhengHei","Noto Sans TC",system-ui,sans-serif; --mono:ui-monospace,"SF Mono",Menlo,Consolas,monospace; }
@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) { --bg:#0a1626; --surface:#0e1b2b; --mat:#17253a; --ink:#f3f0f1; --body:#e4e2e3; --muted:#bbc7dd; --line:rgba(215,227,250,.24); --hair:rgba(215,227,250,.1); --gold:#e3c284;
  --yes:#a6dcbb; --yes-bg:#143a27; --partial:#f0d49a; --partial-bg:#4a3a14; --no:#ffb4ab; --no-bg:#5c1414; color-scheme:dark } }
:root[data-theme="dark"] { --bg:#0a1626; --surface:#0e1b2b; --mat:#17253a; --ink:#f3f0f1; --body:#e4e2e3; --muted:#bbc7dd; --line:rgba(215,227,250,.24); --hair:rgba(215,227,250,.1); --gold:#e3c284;
  --yes:#a6dcbb; --yes-bg:#143a27; --partial:#f0d49a; --partial-bg:#4a3a14; --no:#ffb4ab; --no-bg:#5c1414; color-scheme:dark }
* { box-sizing:border-box } body { background:var(--bg); color:var(--body); font:15px/1.55 var(--sans) }
.wrap { max-width:1240px; margin:0 auto; padding-block:26px 72px; padding-left:max(16px,env(safe-area-inset-left,0px)); padding-right:max(16px,env(safe-area-inset-right,0px)) }
h1,h2 { color:var(--ink); margin:0; text-wrap:balance } h1 { font-size:30px; line-height:1.2 } h2 { font-size:19px; margin-top:34px; padding-top:14px; border-top:2px solid var(--ink) }
p { margin:10px 0 0; max-width:76ch } .eyebrow { font:600 12px/1 var(--sans); letter-spacing:.08em; text-transform:uppercase; color:var(--gold); margin:0 0 8px }
.muted { color:var(--muted); font-size:13.5px }
.scroll { overflow-x:auto; margin-top:14px; border:1px solid var(--line); background:var(--surface) }
table { border-collapse:collapse; width:100%; font-size:13.5px; font-variant-numeric:tabular-nums }
th,td { padding:8px 10px; text-align:left; vertical-align:top; border-bottom:1px solid var(--hair) }
th { font:600 12px/1.3 var(--sans); color:var(--muted); background:var(--mat); white-space:nowrap }
table.detail { min-width:900px } table.detail td:nth-child(2) { color:var(--ink); font-weight:600; min-width:230px } table.detail td:nth-child(1) { color:var(--muted); white-space:nowrap }
table.over td:first-child { font-weight:700; color:var(--ink) } table.over td:first-child a { color:inherit }
.st { font:700 11px/1 var(--mono); padding:4px 6px; white-space:nowrap }
.st.yes { color:var(--yes); background:var(--yes-bg) } .st.partial { color:var(--partial); background:var(--partial-bg) } .st.no { color:var(--no); background:var(--no-bg) }
.bar { display:flex; width:140px; height:8px; background:var(--no-bg) } .bar i { display:block; height:100% } .bar .yes { background:var(--yes) } .bar .partial { background:var(--partial) }
.key { display:flex; flex-wrap:wrap; gap:6px 16px; margin-top:12px; font-size:13px; color:var(--muted) }
</style>
<div class="wrap">
<p class="eyebrow">Taff · benchmark</p>
<h1>What the field does, and what Taff does today</h1>
<p>${total(null)} functions that project-management products offer, grouped, each marked against Taff as it stands: <strong>${count(null, "yes")} yes</strong>, <strong>${count(null, "partial")} partly</strong>, <strong>${count(null, "no")} no</strong>.</p>
<p class="muted">“Seen in” names the products the reading material gives as a reference; it comes from vendor documentation and was not tested by hand. “Where in Taff” names objects of Taff's own model, checked against the code.</p>
<div class="scroll"><table class="over"><thead><tr><th>Group</th><th>Functions</th><th>Yes</th><th>Partly</th><th>No</th><th>Coverage</th></tr></thead><tbody>
${GROUPS.map((group, index) => `<tr><td><a href="#g${index}">${esc(group)}</a></td><td>${total(group)}</td><td>${count(group, "yes")}</td><td>${count(group, "partial")}</td><td>${count(group, "no")}</td><td>${bar(group)}</td></tr>`).join("\n")}
<tr><td>All</td><td>${total(null)}</td><td>${count(null, "yes")}</td><td>${count(null, "partial")}</td><td>${count(null, "no")}</td><td>${bar(null)}</td></tr>
</tbody></table></div>
<p class="key"><span><span class="st yes">Yes</span> Taff has it</span><span><span class="st partial">Partly</span> some of it exists</span><span><span class="st no">No</span> not in Taff</span></p>
${GROUPS.map(
  (group, index) => `<h2 id="g${index}">${esc(group)}</h2>
<div class="scroll"><table class="detail"><thead><tr><th>Category</th><th>Function</th><th>Seen in</th><th>Taff</th><th>Where in Taff</th><th>Note</th></tr></thead><tbody>
${CAPABILITIES.filter((item) => item.group === group)
  .map(
    (item) =>
      `<tr><td>${esc(item.category)}</td><td>${esc(item.name)}</td><td>${esc(item.seenIn)}</td><td><span class="st ${item.taff}">${word[item.taff]}</span></td><td>${esc(where(item.where))}</td><td>${esc(item.note)}</td></tr>`,
  )
  .join("\n")}
</tbody></table></div>`,
).join("\n")}
</div>
`;
}

if (process.argv[1]?.endsWith("benchmark-doc.mts")) {
  const target = path.join(repoRoot, "docs/benchmark/function-map.md");
  const next = markdown();
  if (process.argv.includes("--check")) {
    let current = "";
    try {
      current = readFileSync(target, "utf8");
    } catch {}
    if (current !== next) {
      console.error(
        "docs/benchmark/function-map.md is stale; run pnpm arch:benchmark",
      );
      process.exit(1);
    }
    console.info("function map is current");
  } else {
    writeFileSync(target, next);
    const out = path.join(repoRoot, "architecture/.site");
    mkdirSync(out, { recursive: true });
    writeFileSync(path.join(out, "benchmark.fragment.html"), page());
    console.info(
      `wrote docs/benchmark/function-map.md: ${total(null)} functions, ${count(null, "yes")} yes, ${count(null, "partial")} partly, ${count(null, "no")} no`,
    );
  }
}
