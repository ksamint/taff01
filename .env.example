# Local development only. Replace all dummy values in your own .env.
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgres://taff:replace-with-local-password@127.0.0.1:55432/taff
# Integration tests require a SEPARATE database whose name ends in _test.
TEST_DATABASE_URL=postgres://taff:replace-with-local-password@127.0.0.1:55432/taff_test
# Valkey (or any Redis-protocol server). ioredis and BullMQ use the redis:// scheme.
REDIS_URL=redis://127.0.0.1:56379
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-at-least-32-random-characters
API_INTERNAL_URL=http://127.0.0.1:3001
API_PORT=3001
DEMO_EMAIL=alex@taff.local
DEMO_PASSWORD=replace-with-demo-password
# Agent tokens are stored as sha256(token + TOKEN_PEPPER); at least 16 characters.
TOKEN_PEPPER=replace-with-random-token-pepper
# MCP calls allowed per token per minute.
MCP_RATE_LIMIT=60
