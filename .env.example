# Local development only. Replace all dummy values in your own .env.
POSTGRES_PASSWORD=replace-with-local-password
DATABASE_URL=postgres://taff:replace-with-local-password@127.0.0.1:55432/taff
# Integration tests require a SEPARATE database whose name ends in _test.
TEST_DATABASE_URL=postgres://taff:replace-with-local-password@127.0.0.1:55432/taff_test
# Valkey (or any Redis-protocol server). ioredis and BullMQ use the redis:// scheme.
REDIS_URL=redis://127.0.0.1:56379
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-at-least-32-random-characters
API_INTERNAL_URL=http://127.0.0.1:3001
API_PORT=3001
# Interface the API binds; keep loopback behind a proxy, 0.0.0.0 in a container.
API_HOST=127.0.0.1
DEMO_EMAIL=alex@taff.local
DEMO_PASSWORD=replace-with-demo-password
# Optional fixed local date for isolated UI captures; omit for normal development.
# SEED_DATE=2026-10-08
# Agent tokens are stored as sha256(token + TOKEN_PEPPER); at least 16 characters.
TOKEN_PEPPER=replace-with-random-token-pepper
# MCP calls allowed per token per minute.
MCP_RATE_LIMIT=60
# Optional Tencent Cloud SMS login: configure all five values or leave all empty.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_ID=
TENCENT_SMS_REGION=ap-guangzhou
# Production worker image override; used by compose.apuch.yaml.
TAFF_IMAGE_WORKER=taff-worker
# External production PostgreSQL CA; unused by local development.
POSTGRES_CA_FILE=/srv/taff/secrets/postgresql-ca.crt

# Optional all-or-none SMTP configuration. No fields => private logging mailbox.
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
# Contains private invitation/verification links; never expose or commit this file.
EMAIL_LOG_PATH=.taff-mail/messages.jsonl

# Optional derived relationship graph. PostgreSQL remains authoritative.
# Set URI, username and password together; leave all three empty to disable.
# Production uses bolt+s://neo4j01.internal.apuch.art:7687 on ins-aj5kmjag.
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
