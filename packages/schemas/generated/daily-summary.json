{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "layout": {
          "type": "object",
          "properties": {
            "version": {
              "type": "number",
              "const": 1
            },
            "locale": {
              "type": "string",
              "enum": [
                "en",
                "zh-CN",
                "zh-HK"
              ]
            },
            "header": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "audience": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 220
                },
                "workspace": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 140
                },
                "date": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                }
              },
              "required": [
                "title",
                "audience",
                "workspace",
                "date"
              ],
              "additionalProperties": false
            },
            "kpis": {
              "maxItems": 7,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "key": {
                    "type": "string",
                    "enum": [
                      "projects",
                      "open",
                      "completedToday",
                      "dueToday",
                      "overdue",
                      "blocked",
                      "inReview"
                    ]
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "value": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20
                  },
                  "tone": {
                    "type": "string",
                    "enum": [
                      "neutral",
                      "warning",
                      "danger"
                    ]
                  }
                },
                "required": [
                  "key",
                  "label",
                  "value",
                  "tone"
                ],
                "additionalProperties": false
              }
            },
            "projects": {
              "maxItems": 100,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 140
                  },
                  "stage": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "risk": {
                    "type": "object",
                    "properties": {
                      "level": {
                        "type": "string",
                        "enum": [
                          "low",
                          "medium",
                          "high"
                        ]
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 60
                      },
                      "reasons": {
                        "maxItems": 4,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 120
                        }
                      }
                    },
                    "required": [
                      "level",
                      "label",
                      "reasons"
                    ],
                    "additionalProperties": false
                  },
                  "meta": {
                    "maxItems": 3,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  },
                  "progress": {
                    "type": "object",
                    "properties": {
                      "percent": {
                        "type": "number"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      }
                    },
                    "required": [
                      "percent",
                      "label"
                    ],
                    "additionalProperties": false
                  },
                  "finance": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "percent": {
                            "type": [
                              "number",
                              "null"
                            ]
                          },
                          "label": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 240
                          }
                        },
                        "required": [
                          "percent",
                          "label"
                        ],
                        "additionalProperties": false
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "agentRuns": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 240
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "sections": {
                    "maxItems": 5,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "key": {
                          "type": "string",
                          "enum": [
                            "completedToday",
                            "movedToday",
                            "dueToday",
                            "overdue",
                            "blocked"
                          ]
                        },
                        "title": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "count": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 20
                        },
                        "items": {
                          "maxItems": 20,
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "number": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 20
                              },
                              "title": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 220
                              },
                              "detail": {
                                "type": "string",
                                "maxLength": 300
                              },
                              "overdue": {
                                "type": "boolean"
                              }
                            },
                            "required": [
                              "number",
                              "title",
                              "detail",
                              "overdue"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "more": {
                          "anyOf": [
                            {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 100
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "required": [
                        "key",
                        "title",
                        "count",
                        "items",
                        "more"
                      ],
                      "additionalProperties": false
                    }
                  }
