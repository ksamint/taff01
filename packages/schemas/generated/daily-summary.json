                "watermark": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                },
                "hashLabel": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 40
                },
                "hashShort": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{8}…[a-f0-9]{4}$"
                },
                "hashFull": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "generated",
                "watermark",
                "hashLabel",
