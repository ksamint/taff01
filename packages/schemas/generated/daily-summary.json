                "required": [
                  "name",
                  "stage",
                  "risk",
                  "meta",
                  "progress",
                  "finance",
                  "agentRuns",
                  "sections"
                ],
                "additionalProperties": false
              }
            },
            "moreProjects": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
