{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProjectMargin",
  "type": "object",
  "required": [
    "actualMicros",
    "currency",
    "marginMicros",
    "paidMicros"
  ],
  "properties": {
    "actualMicros": {
      "type": "integer",
      "format": "int64",
      "maximum": 9007199254740991.0,
      "minimum": 0.0
    },
    "currency": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z]{3}$"
    },
    "marginMicros": {
      "type": "integer",
      "format": "int64",
      "maximum": 9007199254740991.0,
      "minimum": -9007199254740991.0
    },
    "paidMicros": {
      "type": "integer",
      "format": "int64",
      "maximum": 9007199254740991.0,
      "minimum": 0.0
    }
  },
  "additionalProperties": false
}
