views {
  view planning of fn.planning {
    title 'Module · Planning (Gantt)'
    include *, fn.planning.**
    include fn.planning.rules.* -> fn.**
  }
  view calendar of fn.calendar {
    title 'Module · Calendar'
    include *, fn.calendar.**
    include fn.calendar.rules.* -> fn.**
  }
  view agents of fn.agents {
    title 'Module · Agents, runs and review'
    include *, fn.agents.**
    include fn.agents.rules.* -> fn.**
  }
  view access of fn.access {
    title 'Module · Access: tokens, OAuth and MCP'
    include *, fn.access.**
    include fn.access.rules.* -> fn.**
  }
  view inbox of fn.inbox {
    title 'Module · Inbox and notifications'
    include *, fn.inbox.**
    include fn.inbox.rules.* -> fn.**
  }
  view summaries of fn.summaries {
    title 'Module · Shareholder summaries'
    include *, fn.summaries.**
    include fn.summaries.rules.* -> fn.**
  }
  view crm of fn.crm {
    title 'Module · Companies and contacts'
    include *, fn.crm.**
    include fn.crm.rules.* -> fn.**
  }
  view relations of fn.relations {
    title 'Module · Relations graph'
    include *, fn.relations.**
    include fn.relations.rules.* -> fn.**
  }
  view mind of fn.mind {
    title 'Module · Mind map'
    include *, fn.mind.**
    include fn.mind.rules.* -> fn.**
  }
  view sectors of fn.sectors {
    title 'Module · Sectors (operation template)'
    include *, fn.sectors.**
    include fn.sectors.rules.* -> fn.**
  }
  view assistant of fn.assistant {
    title 'Module · AI brief, Ask and suggestions'
    include *, fn.assistant.**
    include fn.assistant.rules.* -> fn.**
  }
  view export of fn.export {
    title 'Module · Exported view images'
    include *, fn.export.**
    include fn.export.rules.* -> fn.**
  }
  view audit of fn.audit {
    title 'Module · Audit and realtime'
    include *, fn.audit.**
    include fn.audit.rules.* -> fn.**
  }
  view identity of fn.identity {
    title 'Module · Sign-in and profile'
    include *, fn.identity.**
    include fn.identity.rules.* -> fn.**
  }
  view orgs of fn.orgs {
    title 'Module · Organizations and members'
