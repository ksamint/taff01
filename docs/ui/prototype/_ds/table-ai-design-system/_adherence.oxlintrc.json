        "selector": "JSXOpeningElement[name.name='DonutChart'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|highlight|size|thickness|centerValue|centerLabel|format|unit|legend|style|key|ref|className|style|children)$/]",
        "message": "<DonutChart> doesn't accept that prop. Declared props: data, highlight, size, thickness, centerValue, centerLabel, format, unit, legend, style."
      },
